<Application
    x:Class="Smart_Sudoku.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Smart_Sudoku"
    RequestedTheme="Light">
    <!-- אובייקט: Application — האפליקציה כולה. כאן מוגדרים הצבעים והסגנונות שכל העמודים משתמשים בהם. -->

    <Application.Resources>
        <ResourceDictionary>
        <!-- אובייקט: ResourceDictionary — "מילון" של משאבים משותפים: צבעים וסגנונות, כל אחד עם שם (x:Key) שאפשר להשתמש בו בכל עמוד. -->

            <!-- Palette -->
            <LinearGradientBrush x:Key="PageBackgroundBrush" StartPoint="0,0" EndPoint="1,1">
            <!-- אובייקט: PageBackgroundBrush — הצבע המדורג של הרקע של כל העמודים (משתנה לפי ערכת העיצוב). -->
                <GradientStop Color="#FFFFF4F8" Offset="0" />
                <!-- אובייקט: GradientStop — "תחנת צבע": באיזה צבע המעבר מתחיל (Offset=0). -->
                <GradientStop Color="#FFFCE1EC" Offset="1" />
                <!-- אובייקט: GradientStop — "תחנת צבע": באיזה צבע המעבר נגמר (Offset=1). -->
            </LinearGradientBrush>
            <SolidColorBrush x:Key="BerryBrush" Color="#FF8A2A55" />
            <!-- אובייקט: BerryBrush — הצבע הכהה, לכותרות ולטקסט חשוב. -->
            <SolidColorBrush x:Key="RoseBrush" Color="#FFE75A97" />
            <!-- אובייקט: RoseBrush — הצבע הבולט של הערכה (מסגרות, כפתורים מודגשים, מספרים של השחקן). -->
            <SolidColorBrush x:Key="SoftPinkBrush" Color="#FFF6C6DA" />
            <!-- אובייקט: SoftPinkBrush — צבע רך לקווים ולמסגרות דקות. -->
            <SolidColorBrush x:Key="MutedTextBrush" Color="#FFA0607E" />
            <!-- אובייקט: MutedTextBrush — צבע עדין לטקסט משני (הסברים קטנים). -->
            <SolidColorBrush x:Key="DecoBrush" Color="#FFF48FB1" />
            <!-- אובייקט: DecoBrush — צבע לקישוטים ולחגיגות. -->
            <SolidColorBrush x:Key="SelectedCellBrush" Color="#FFF9C5DA" />
            <!-- אובייקט: SelectedCellBrush — הצבע של משבצת שנבחרה ושל כפתור מודגש. -->
            <SolidColorBrush x:Key="SameNumberBrush" Color="#FFFBD8E6" />
            <!-- אובייקט: SameNumberBrush — הצבע של משבצות עם אותו מספר כמו המשבצת שנבחרה. -->
            <SolidColorBrush x:Key="RelatedCellBrush" Color="#FFFEF0F6" />
            <!-- אובייקט: RelatedCellBrush — הצבע של משבצות באותה שורה, עמודה או ריבוע. -->
            <SolidColorBrush x:Key="ButtonHoverBrush" Color="#FFFFF6FA" />
            <!-- אובייקט: ButtonHoverBrush — הצבע של כפתור כשהעכבר מעליו. -->
            <SolidColorBrush x:Key="ButtonPressedBrush" Color="#FFFBD6E5" />
            <!-- אובייקט: ButtonPressedBrush — הצבע של כפתור בזמן לחיצה. -->
            <SolidColorBrush x:Key="ShadowBrush" Color="#26E75A97" />
            <!-- אובייקט: ShadowBrush — הצבע השקוף של הצל מתחת לכפתורים. -->
            <SolidColorBrush x:Key="OverlayBrush" Color="#B3FCE1EC" />
            <!-- אובייקט: OverlayBrush — הצבע השקוף של שכבה שמכסה את המסך (חלון ניצחון, הפסקה). -->
            <SolidColorBrush x:Key="CardBrush" Color="White" />
            <!-- אובייקט: CardBrush — צבע הרקע של כרטיסים ומשבצות (לבן ביום, כהה בלילה). -->
            <!-- The colors above are swapped at runtime by Themes.Apply -->

            <!-- White rounded button used across the app -->
            <Style x:Key="WhiteButton" TargetType="Button">
            <!-- אובייקט: WhiteButton — הסגנון של הכפתור הלבן המעוגל שבכל האפליקציה: צבעים, גודל טקסט, ריפוד, פינות מעוגלות, -->
            <!-- וגם איך הוא נראה (Template) ואיך הוא משתנה כשהעכבר מעליו, כשלוחצים עליו וכשהוא לא פעיל. -->
                <Setter Property="Background" Value="{StaticResource CardBrush}" />
                <Setter Property="Foreground" Value="{StaticResource BerryBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource SoftPinkBrush}" />
                <Setter Property="BorderThickness" Value="1.5" />
                <Setter Property="FontSize" Value="20" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Padding" Value="32,12" />
                <Setter Property="CornerRadius" Value="18" />
                <Setter Property="HorizontalContentAlignment" Value="Center" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="UseSystemFocusVisuals" Value="True" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                        <!-- אובייקט: ControlTemplate — "התבנית" שקובעת ממה הכפתור בנוי: צל מתחת, ומעליו מסגרת עם התוכן. -->
                            <Grid>
                            <!-- אובייקט: Grid — "מגש" שמחזיק את הצל ואת המסגרת זה מעל זה. -->
                                <Border x:Name="Shadow"
                                        Margin="0,4,0,-4"
                                        Background="{StaticResource ShadowBrush}"
                                        CornerRadius="{TemplateBinding CornerRadius}" />
                                        <!-- אובייקט: Shadow — הצל של הכפתור, קצת מתחתיו. -->
                                <Border x:Name="Root"
                                        Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}"
                                        CornerRadius="{TemplateBinding CornerRadius}"
                                        Padding="{TemplateBinding Padding}">
                                        <!-- אובייקט: Root — המסגרת המעוגלת של הכפתור, עם הרקע. -->
                                    <ContentPresenter x:Name="Content"
                                                      Content="{TemplateBinding Content}"
                                                      ContentTemplate="{TemplateBinding ContentTemplate}"
                                                      Foreground="{TemplateBinding Foreground}"
                                                      HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                                                      <!-- אובייקט: Content — המקום שבו מוצג מה שכתוב בכפתור (טקסט או אימוג'י). -->
                                </Border>
                                <VisualStateManager.VisualStateGroups>
                                <!-- אובייקט: VisualStateGroups — המצבים השונים של הכפתור, וכל מצב משנה את הצבעים. -->
                                    <VisualStateGroup x:Name="CommonStates">
                                    <!-- אובייקט: CommonStates — קבוצת המצבים הרגילה: רגיל, עכבר מעל, לחוץ, לא פעיל. -->
                                        <VisualState x:Name="Normal" />
                                        <!-- אובייקט: Normal — המצב הרגיל, בלי שינויים. -->
                                        <VisualState x:Name="PointerOver">
                                        <!-- אובייקט: PointerOver — כשהעכבר מעל הכפתור: הרקע מתבהר והמסגרת נצבעת בצבע הבולט. -->
                                            <VisualState.Setters>
                                                <Setter Target="Root.Background" Value="{StaticResource ButtonHoverBrush}" />
                                                <Setter Target="Root.BorderBrush" Value="{StaticResource RoseBrush}" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Pressed">
                                        <!-- אובייקט: Pressed — בזמן לחיצה: הרקע מתכהה והצל נעלם (כאילו הכפתור "נלחץ פנימה"). -->
                                            <VisualState.Setters>
                                                <Setter Target="Root.Background" Value="{StaticResource ButtonPressedBrush}" />
                                                <Setter Target="Root.BorderBrush" Value="{StaticResource RoseBrush}" />
                                                <Setter Target="Shadow.Opacity" Value="0" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Disabled">
                                        <!-- אובייקט: Disabled — כשהכפתור לא פעיל: הוא נהיה חצי שקוף. -->
                                            <VisualState.Setters>
                                                <Setter Target="Root.Opacity" Value="0.5" />
                                            </VisualState.Setters>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Every Button gets the white style unless it says otherwise -->
            <Style TargetType="Button" BasedOn="{StaticResource WhiteButton}" />
            <!-- אובייקט: Style (לכל הכפתורים) — סגנון בלי שם: כל כפתור באפליקציה מקבל אוטומטית את הסגנון הלבן. -->

            <!-- Round icon button (back, help) -->
            <Style x:Key="CircleButton" TargetType="Button" BasedOn="{StaticResource WhiteButton}">
            <!-- אובייקט: CircleButton — כפתור עגול קטן (חזרה, עזרה, צליל): 52×52 עם פינות עגולות לגמרי. -->
                <Setter Property="Width" Value="52" />
                <Setter Property="Height" Value="52" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="CornerRadius" Value="26" />
                <Setter Property="FontSize" Value="22" />
                <Setter Property="FontWeight" Value="Bold" />
            </Style>

            <!-- Number pad button -->
            <Style x:Key="NumberButton" TargetType="Button" BasedOn="{StaticResource WhiteButton}">
            <!-- אובייקט: NumberButton — הסגנון של כפתורי המספרים מתחת ללוח. -->
                <Setter Property="Width" Value="52" />
                <Setter Property="Height" Value="60" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="CornerRadius" Value="16" />
                <Setter Property="FontSize" Value="26" />
            </Style>

            <Style x:Key="TitleText" TargetType="TextBlock">
            <!-- אובייקט: TitleText — הסגנון של כותרת גדולה בראש עמוד: גדולה, מודגשת ובמרכז. -->
                <Setter Property="FontSize" Value="40" />
                <Setter Property="FontWeight" Value="Bold" />
                <Setter Property="Foreground" Value="{StaticResource BerryBrush}" />
                <Setter Property="HorizontalAlignment" Value="Center" />
                <Setter Property="TextAlignment" Value="Center" />
            </Style>

            <Style x:Key="SubtitleText" TargetType="TextBlock">
            <!-- אובייקט: SubtitleText — הסגנון של כותרת המשנה: קטנה יותר, בצבע עדין, ושוברת שורות. -->
                <Setter Property="FontSize" Value="18" />
                <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
                <Setter Property="HorizontalAlignment" Value="Center" />
                <Setter Property="TextAlignment" Value="Center" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>

            <!-- White rounded card -->
            <Style x:Key="Card" TargetType="Border">
            <!-- אובייקט: Card — הסגנון של "כרטיס" לבן מעוגל, שבתוכו מסדרים תוכן. -->
                <Setter Property="Background" Value="{StaticResource CardBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource SoftPinkBrush}" />
                <Setter Property="BorderThickness" Value="1.5" />
                <Setter Property="CornerRadius" Value="24" />
                <Setter Property="Padding" Value="32" />
            </Style>

        </ResourceDictionary>
    </Application.Resources>
</Application>

<Page
    x:Class="Smart_Sudoku.Pages.HelpPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Smart_Sudoku.Pages"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{StaticResource PageBackgroundBrush}">

    <Page.Resources>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="24" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{StaticResource RoseBrush}" />
            <Setter Property="Margin" Value="0,8,0,4" />
        </Style>
        <Style x:Key="Bullet" TargetType="TextBlock">
            <Setter Property="FontSize" Value="18" />
            <Setter Property="LineHeight" Value="28" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Foreground" Value="{StaticResource BerryBrush}" />
        </Style>
    </Page.Resources>

    <Grid>
        <Button Style="{StaticResource CircleButton}"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Margin="24"
                Canvas.ZIndex="1"
                ToolTipService.ToolTip="חזרה למשחק"
                AutomationProperties.Name="חזרה"
                Click="BackButton_Click">
            <FontIcon Glyph="&#xE72B;" FontSize="20" />
        </Button>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="24,90,24,32" Spacing="20" MaxWidth="640">
                <TextBlock Text="איך משחקים סודוקו?" Style="{StaticResource TitleText}" />

                <Border Style="{StaticResource Card}" FlowDirection="RightToLeft">
                    <StackPanel Spacing="10">

                        <TextBlock Text="מהו סודוקו?" Style="{StaticResource SectionTitle}" />
                        <TextBlock Style="{StaticResource Bullet}"><Run Text="♥  " Foreground="{StaticResource RoseBrush}" />חידת היגיון עם לוח של 9×9 משבצות.</TextBlock>
                        <TextBlock Style="{StaticResource Bullet}"><Run Text="♥  " Foreground="{StaticResource RoseBrush}" />הלוח מחולק ל-9 ריבועים קטנים של 3×3.</TextBlock>
                        <TextBlock Style="{StaticResource Bullet}"><Run Text="♥  " Foreground="{StaticResource RoseBrush}" />חלק מהמשבצות כבר מלאות, והמטרה היא למלא את כל השאר.</TextBlock>
                        <TextBlock Style="{StaticResource Bullet}"><Run Text="♥  " Foreground="{StaticResource RoseBrush}" />לא צריך לחשב כלום — רק לחשוב בהיגיון.</TextBlock>

                        <Rectangle Height="1.5" Fill="{StaticResource SoftPinkBrush}" Margin="0,12" />

                        <TextBlock Text="החוקים" Style="{StaticResource SectionTitle}" />
                        <TextBlock Style="{StaticResource Bullet}"><Run Text="♥  " Foreground="{StaticResource RoseBrush}" />בכל <Bold>שורה</Bold> יופיעו המספרים 1 עד 9, כל מספר פעם אחת.</TextBlock>
                        <TextBlock Style="{StaticResource Bullet}"><Run Text="♥  " Foreground="{StaticResource RoseBrush}" />בכל <Bold>עמודה</Bold> יופיעו המספרים 1 עד 9, כל מספר פעם אחת.</TextBlock>
                        <TextBlock Style="{StaticResource Bullet}"><Run Text="♥  " Foreground="{StaticResource RoseBrush}" />בכל <Bold>ריבוע 3×3</Bold> יופיעו המספרים 1 עד 9, כל מספר פעם אחת.</TextBlock>

                        <Rectangle Height="1.5" Fill="{StaticResource SoftPinkBrush}" Margin="0,12" />

                        <TextBlock Text="איך משחקים באפליקציה?" Style="{StaticResource SectionTitle}" />
                        <TextBlock Style="{StaticResource Bullet}"><Run Text="♥  " Foreground="{StaticResource RoseBrush}" />לוחצים על משבצת ריקה, ואז על מספר מהלחצנים למטה.</TextBlock>
                        <TextBlock Style="{StaticResource Bullet}"><Run Text="♥  " Foreground="{StaticResource RoseBrush}" />מספר שגוי יופיע <Run Text="באדום" Foreground="#FFD93A4A" FontWeight="SemiBold" />.</TextBlock>
                        <TextBlock Style="{StaticResource Bullet}"><Run Text="♥  " Foreground="{StaticResource RoseBrush}" />טעיתם? בוחרים את המשבצת ולוחצים על <Bold>מחק</Bold>.</TextBlock>
                        <TextBlock Style="{StaticResource Bullet}"><Run Text="♥  " Foreground="{StaticResource RoseBrush}" /><Bold>משחק חוזר</Bold> מתחיל לוח חדש באותו שלב.</TextBlock>
                        <TextBlock Style="{StaticResource Bullet}"><Run Text="♥  " Foreground="{StaticResource RoseBrush}" />ככל שהשלב גבוה יותר, יש פחות מספרים בהתחלה.</TextBlock>

                        <Border Background="#FFFFF1F6" CornerRadius="14" Padding="18,14" Margin="0,16,0,0">
                            <TextBlock Style="{StaticResource Bullet}"><Bold>💡 טיפ:</Bold> התחילו משורות, עמודות וריבועים שכמעט מלאים — שם הכי קל לגלות מה חסר.</TextBlock>
                        </Border>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>

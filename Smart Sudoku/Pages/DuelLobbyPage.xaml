<Page
    x:Class="Smart_Sudoku.Pages.DuelLobbyPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Smart_Sudoku.Pages"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="Transparent">

    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="24,96,24,32" Spacing="18" MaxWidth="600" FlowDirection="RightToLeft">
                <TextBlock Text="דו-קרב ברשת ⚔️" Style="{StaticResource TitleText}" />
                <TextBlock Text="כולם פותרים את אותו לוח באותו הזמן. תא נכון +10, טעות −5, ומי שמסיים ראשון מקבל בונוס. הניקוד הגבוה מנצח! מי שפותר את הלוח מקבל מטבעות כמו בשלב רגיל, והמנצח/ת מקבל/ת עוד 150 🪙"
                           Style="{StaticResource SubtitleText}" />

                <!-- Step 1: connect to the server and a room -->
                <Border x:Name="ConnectCard" Style="{StaticResource Card}">
                    <StackPanel Spacing="14">
                        <TextBox x:Name="ServerBox"
                                 Header="כתובת השרת"
                                 PlaceholderText="למשל 127.0.0.1 או 192.168.1.20"
                                 FontSize="18"
                                 CornerRadius="12"
                                 FlowDirection="LeftToRight" />
                        <TextBox x:Name="RoomBox"
                                 Header="קוד חדר (לא חובה)"
                                 PlaceholderText="למשל: כיתה-ח או 1234"
                                 MaxLength="20"
                                 FontSize="18"
                                 CornerRadius="12" />
                        <TextBlock Text="רק מי שמקליד את אותו קוד חדר ישחק איתך. בלי קוד — כולם בחדר הראשי."
                                   FontSize="14"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   TextWrapping="Wrap" />
                        <TextBlock x:Name="ConnectError"
                                   Foreground="#FFD93A4A"
                                   FontSize="15"
                                   TextWrapping="Wrap"
                                   Visibility="Collapsed" />
                        <Button x:Name="ConnectButton" Content="התחברות" HorizontalAlignment="Stretch" Click="Connect_Click" />
                    </StackPanel>
                </Border>

                <!-- Step 2: the room -->
                <Border x:Name="RoomCard" Style="{StaticResource Card}" Visibility="Collapsed">
                    <StackPanel Spacing="14">
                        <TextBlock x:Name="RoomTitle" FontSize="22" FontWeight="Bold" Foreground="{StaticResource RoseBrush}" />
                        <StackPanel x:Name="PlayersList" Spacing="8" />
                        <TextBlock x:Name="RoomHint"
                                   FontSize="15"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   TextWrapping="Wrap" />

                        <TextBlock Text="דרגת קושי לדו-קרב" FontSize="17" FontWeight="SemiBold" Foreground="{StaticResource BerryBrush}" />
                        <StackPanel x:Name="DifficultyPanel" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center" />

                        <Button x:Name="StartButton"
                                Content="Start ▶"
                                HorizontalAlignment="Stretch"
                                FontSize="24"
                                Padding="32,14"
                                BorderThickness="2.5"
                                BorderBrush="{StaticResource RoseBrush}"
                                Foreground="{StaticResource RoseBrush}"
                                Click="Start_Click" />
                        <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center">
                            <Button Content="🏆 טבלת אלופים" FontSize="15" Padding="18,6" Click="Leaderboard_Click" />
                            <Button Content="יציאה מהחדר" FontSize="15" Padding="18,6" Click="Leave_Click" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Champions table (from the server's database) -->
                <Border x:Name="LeaderboardCard" Style="{StaticResource Card}" Visibility="Collapsed">
                    <StackPanel Spacing="10">
                        <TextBlock Text="🏆 טבלת האלופים" FontSize="22" FontWeight="Bold" Foreground="{StaticResource RoseBrush}" />
                        <StackPanel x:Name="LeaderboardList" Spacing="6" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Button Style="{StaticResource CircleButton}"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Margin="24"
                ToolTipService.ToolTip="חזרה"
                AutomationProperties.Name="חזרה"
                Click="BackButton_Click">
            <FontIcon Glyph="&#xE72B;" FontSize="20" />
        </Button>
    </Grid>
</Page>

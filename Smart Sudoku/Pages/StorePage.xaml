<Page
    x:Class="Smart_Sudoku.Pages.StorePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Smart_Sudoku.Pages"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="Transparent">

    <Page.Resources>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="24" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{StaticResource RoseBrush}" />
        </Style>
    </Page.Resources>

    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="24,96,24,32" Spacing="20" MaxWidth="760">
                <TextBlock Text="חנות 🛍️" Style="{StaticResource TitleText}" />
                <TextBlock Text="מרוויחים מטבעות על כל שלב — וכמה שיותר כוכבים, יותר מטבעות!"
                           Style="{StaticResource SubtitleText}" />

                <TextBlock x:Name="MessageText"
                           Style="{StaticResource SubtitleText}"
                           Foreground="{StaticResource BerryBrush}"
                           FontWeight="SemiBold"
                           Visibility="Collapsed" />

                <!-- Hints -->
                <Border Style="{StaticResource Card}" FlowDirection="RightToLeft">
                    <Grid ColumnSpacing="20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="💡" FontSize="44" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                            <TextBlock Text="חבילת 3 רמזים" Style="{StaticResource SectionTitle}" />
                            <TextBlock x:Name="BonusHintsText"
                                       FontSize="16"
                                       Foreground="{StaticResource MutedTextBrush}"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                        <Button x:Name="BuyHintsButton"
                                Grid.Column="2"
                                MinWidth="140"
                                Click="BuyHintsButton_Click" />
                    </Grid>
                </Border>

                <!-- Hearts -->
                <Border Style="{StaticResource Card}" FlowDirection="RightToLeft">
                    <Grid ColumnSpacing="20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="💖" FontSize="44" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                            <TextBlock Text="לב נוסף" Style="{StaticResource SectionTitle}" />
                            <TextBlock x:Name="BonusLivesText"
                                       FontSize="16"
                                       Foreground="{StaticResource MutedTextBrush}"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                        <Button x:Name="BuyLifeButton"
                                Grid.Column="2"
                                MinWidth="140"
                                Click="BuyLifeButton_Click" />
                    </Grid>
                </Border>

                <!-- Color themes -->
                <Border Style="{StaticResource Card}" FlowDirection="RightToLeft">
                    <StackPanel Spacing="16">
                        <TextBlock Text="🎨 ערכות צבעים" Style="{StaticResource SectionTitle}" />
                        <Grid x:Name="ThemesGrid" ColumnSpacing="14" RowSpacing="14" />
                    </StackPanel>
                </Border>

                <!-- Symbol sets -->
                <Border Style="{StaticResource Card}" FlowDirection="RightToLeft">
                    <StackPanel Spacing="16">
                        <TextBlock Text="🍓 סמלים בלוח" Style="{StaticResource SectionTitle}" />
                        <Grid x:Name="SymbolsGrid" ColumnSpacing="14" RowSpacing="14" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Button Style="{StaticResource CircleButton}"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Margin="24"
                ToolTipService.ToolTip="חזרה"
                AutomationProperties.Name="חזרה"
                Click="BackButton_Click">
            <FontIcon Glyph="&#xE72B;" FontSize="20" />
        </Button>

        <TextBlock x:Name="CoinsText"
                   HorizontalAlignment="Right"
                   VerticalAlignment="Top"
                   Margin="24,34,32,0"
                   FontSize="24"
                   FontWeight="SemiBold"
                   Foreground="{StaticResource BerryBrush}"
                   Text="🪙 0" />
    </Grid>
</Page>

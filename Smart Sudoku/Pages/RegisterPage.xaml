<local:BasePage
    x:Class="Smart_Sudoku.Pages.RegisterPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Smart_Sudoku.Pages"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="Transparent">
    <!-- אובייקט: RegisterPage — עמוד ההרשמה. הוא יורש מ-BasePage, והרקע שלו שקוף כדי שיראו את רקע ערכת העיצוב. -->

    <Grid>
    <!-- אובייקט: Grid — "מגש" שמחזיק את כפתור החזרה ואת טופס ההרשמה. -->
        <Button Style="{StaticResource CircleButton}"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Margin="24"
                ToolTipService.ToolTip="חזרה"
                AutomationProperties.Name="חזרה"
                Click="BackButton_Click">
                <!-- אובייקט: Button — כפתור "חזרה" עגול בפינה. לחיצה עליו מפעילה את BackButton_Click. -->
            <FontIcon Glyph="&#xE72B;" FontSize="20" />
            <!-- אובייקט: FontIcon — האייקון של החץ שבתוך כפתור החזרה. -->
        </Button>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
        <!-- אובייקט: ScrollViewer — מאפשר לגלול כשהמסך קטן. -->
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24,90,24,24" Spacing="20" Width="420">
            <!-- אובייקט: StackPanel — עמודה במרכז המסך שבה מסודרים הכותרת והטופס. -->
                <TextBlock Text="הרשמה" Style="{StaticResource TitleText}" />
                <!-- אובייקט: TextBlock — הכותרת "הרשמה". -->
                <TextBlock Text="יוצרים משתמש, וההתקדמות נשמרת — אפשר להמשיך מאיפה שעצרתם 💕"
                           Style="{StaticResource SubtitleText}" />
                           <!-- אובייקט: TextBlock — הסבר קצר מתחת לכותרת. -->

                <Border Style="{StaticResource Card}" FlowDirection="RightToLeft">
                <!-- אובייקט: Border — "כרטיס" לבן מעוגל שבתוכו הטופס, מימין לשמאל. -->
                    <StackPanel Spacing="18">
                    <!-- אובייקט: StackPanel — הטופס: כל השדות זה מתחת לזה. -->
                        <TextBox x:Name="UserNameBox"
                                 Header="שם משתמש"
                                 PlaceholderText="2 עד 20 תווים"
                                 MaxLength="20"
                                 FontSize="18"
                                 CornerRadius="12" />
                                 <!-- אובייקט: UserNameBox — תיבה להקלדת שם המשתמש (עד 20 תווים). -->
                        <PasswordBox x:Name="PasswordBox"
                                     Header="סיסמה"
                                     PlaceholderText="6 תווים: A-Z, a-z, ספרה ותו מיוחד"
                                     FontSize="18"
                                     CornerRadius="12" />
                                     <!-- אובייקט: PasswordBox — תיבה להקלדת הסיסמה. התווים מוסתרים בנקודות. -->
                        <PasswordBox x:Name="ConfirmBox"
                                     Header="אימות סיסמה"
                                     FontSize="18"
                                     CornerRadius="12"
                                     KeyDown="Field_KeyDown" />
                                     <!-- אובייקט: ConfirmBox — תיבה להקלדת הסיסמה שוב, כדי לוודא שלא הייתה טעות. Enter כאן = הרשמה (Field_KeyDown). -->
                        <CheckBox x:Name="TransferGuestBox"
                                  Content="להעביר למשתמש החדש את ההתקדמות של האורח במחשב הזה"
                                  Foreground="{StaticResource BerryBrush}"
                                  Visibility="Collapsed" />
                                  <!-- אובייקט: TransferGuestBox — תיבת סימון: להעביר לחשבון החדש את ההתקדמות של האורח. מוסתרת עד שהקוד מגלה שיש התקדמות כזאת. -->
                        <TextBlock x:Name="ErrorText"
                                   Foreground="#FFD93A4A"
                                   FontSize="15"
                                   TextWrapping="Wrap"
                                   Visibility="Collapsed" />
                                   <!-- אובייקט: ErrorText — שורה אדומה להודעות שגיאה (מוסתרת עד שיש שגיאה). -->
                        <Button Content="הרשמה" HorizontalAlignment="Stretch" Click="Register_Click" />
                        <!-- אובייקט: Button — כפתור "הרשמה". לחיצה מפעילה את Register_Click. -->
                        <HyperlinkButton Content="כבר יש לך משתמש? להתחברות"
                                         HorizontalAlignment="Center"
                                         Foreground="{StaticResource RoseBrush}"
                                         Click="SignInLink_Click" />
                                         <!-- אובייקט: HyperlinkButton — קישור "כבר יש לך משתמש?" שעובר לעמוד ההתחברות (SignInLink_Click). -->
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</local:BasePage>

<Page
    x:Class="Smart_Sudoku.Pages.LeaderboardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Smart_Sudoku.Pages"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="Transparent">

    <Page.Resources>
        <Style x:Key="HeaderText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
        </Style>
    </Page.Resources>

    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="24,96,24,32" Spacing="18" MaxWidth="780" FlowDirection="RightToLeft">
                <TextBlock Text="🏆 טבלת שיאים" Style="{StaticResource TitleText}" />
                <TextBlock Text="כל המשתמשים במחשב הזה. אפשר למיין לפי כוכבים, שלבים או מטבעות."
                           Style="{StaticResource SubtitleText}" />

                <!-- Sort buttons, filled in code -->
                <StackPanel x:Name="SortPanel" Orientation="Horizontal" HorizontalAlignment="Center" Spacing="10" />

                <Border Style="{StaticResource Card}" Padding="20">
                    <StackPanel Spacing="10">
                        <!-- Column titles -->
                        <Grid Padding="14,0,14,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="56" />
                                <ColumnDefinition Width="64" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="90" />
                                <ColumnDefinition Width="90" />
                                <ColumnDefinition Width="100" />
                                <ColumnDefinition Width="90" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="2" Text="שחקן/ית" Style="{StaticResource HeaderText}" />
                            <TextBlock Grid.Column="3" Text="⭐ כוכבים" Style="{StaticResource HeaderText}" />
                            <TextBlock Grid.Column="4" Text="✅ שלבים" Style="{StaticResource HeaderText}" />
                            <TextBlock Grid.Column="5" Text="🪙 מטבעות" Style="{StaticResource HeaderText}" />
                            <TextBlock Grid.Column="6" Text="⚡ הכי מהר" Style="{StaticResource HeaderText}" />
                        </Grid>
                        <StackPanel x:Name="RowsPanel" Spacing="8" />
                        <TextBlock x:Name="EmptyText"
                                   Text="עוד אין משתמשים רשומים. נרשמים בתפריט — ומופיעים כאן!"
                                   Style="{StaticResource SubtitleText}"
                                   Visibility="Collapsed" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Button Style="{StaticResource CircleButton}"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Margin="24"
                ToolTipService.ToolTip="חזרה"
                AutomationProperties.Name="חזרה"
                Click="BackButton_Click">
            <FontIcon Glyph="&#xE72B;" FontSize="20" />
        </Button>
    </Grid>

</Page>

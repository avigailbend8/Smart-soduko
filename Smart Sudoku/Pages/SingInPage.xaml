<local:BasePage
    x:Class="Smart_Sudoku.Pages.SingInPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Smart_Sudoku.Pages"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="Transparent">
    <!-- אובייקט: SingInPage — עמוד ההתחברות. הוא יורש מ-BasePage, והרקע שלו שקוף כדי שיראו את רקע ערכת העיצוב. -->

    <Grid>
    <!-- אובייקט: Grid — "מגש" שמחזיק את כפתור החזרה ואת הטפסים. -->
        <Button Style="{StaticResource CircleButton}"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Margin="24"
                ToolTipService.ToolTip="חזרה"
                AutomationProperties.Name="חזרה"
                Click="BackButton_Click">
                <!-- אובייקט: Button — כפתור "חזרה" עגול בפינה. לחיצה עליו מפעילה את BackButton_Click. -->
            <FontIcon Glyph="&#xE72B;" FontSize="20" />
            <!-- אובייקט: FontIcon — האייקון של החץ שבתוך כפתור החזרה. -->
        </Button>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
        <!-- אובייקט: ScrollViewer — מאפשר לגלול כשהמסך קטן. -->
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24,90,24,24" Spacing="20" Width="400">
            <!-- אובייקט: StackPanel — עמודה במרכז המסך שבה מסודרים הכותרת והטפסים. -->
                <TextBlock Text="התחברות" Style="{StaticResource TitleText}" />
                <!-- אובייקט: TextBlock — הכותרת "התחברות". -->
                <TextBlock Text="ברוכים השבים! הכניסו שם משתמש וסיסמה" Style="{StaticResource SubtitleText}" />
                <!-- אובייקט: TextBlock — הסבר קצר מתחת לכותרת. -->

                <Border Style="{StaticResource Card}" FlowDirection="RightToLeft">
                <!-- אובייקט: Border — "כרטיס" לבן מעוגל שבתוכו טופס הכניסה. -->
                    <StackPanel Spacing="18">
                    <!-- אובייקט: StackPanel — טופס הכניסה: כל השדות זה מתחת לזה. -->
                        <TextBox x:Name="UserNameBox"
                                 Header="שם משתמש"
                                 PlaceholderText="השם שלך"
                                 FontSize="18"
                                 CornerRadius="12"
                                 KeyDown="Field_KeyDown" />
                                 <!-- אובייקט: UserNameBox — תיבה להקלדת שם המשתמש. Enter כאן = כניסה (Field_KeyDown). -->
                        <PasswordBox x:Name="PasswordBox"
                                     Header="סיסמה"
                                     FontSize="18"
                                     CornerRadius="12"
                                     KeyDown="Field_KeyDown" />
                                     <!-- אובייקט: PasswordBox — תיבה להקלדת הסיסמה (התווים מוסתרים). Enter כאן = כניסה. -->
                        <TextBlock x:Name="ErrorText"
                                   Foreground="#FFD93A4A"
                                   FontSize="15"
                                   TextWrapping="Wrap"
                                   Visibility="Collapsed" />
                                   <!-- אובייקט: ErrorText — שורה אדומה להודעות שגיאה (מוסתרת עד שיש שגיאה). -->
                        <Button Content="התחבר" HorizontalAlignment="Stretch" Click="SignIn_Click" />
                        <!-- אובייקט: Button — כפתור "התחבר". לחיצה מפעילה את SignIn_Click. -->
                        <HyperlinkButton Content="אין לך משתמש? להרשמה"
                                         HorizontalAlignment="Center"
                                         Foreground="{StaticResource RoseBrush}"
                                         Click="RegisterLink_Click" />
                                         <!-- אובייקט: HyperlinkButton — קישור "אין לך משתמש?" שעובר לעמוד ההרשמה (RegisterLink_Click). -->
                        <HyperlinkButton Content="שכחתי סיסמה 🔑"
                                         HorizontalAlignment="Center"
                                         Foreground="{StaticResource MutedTextBrush}"
                                         Click="ForgotLink_Click" />
                                         <!-- אובייקט: HyperlinkButton — קישור "שכחתי סיסמה" שפותח את הכרטיס של איפוס הסיסמה (ForgotLink_Click). -->
                    </StackPanel>
                </Border>

                <!-- Forgot password: the secret word chosen in the settings gives a new password -->
                <Border x:Name="ForgotPanel" Style="{StaticResource Card}" FlowDirection="RightToLeft" Visibility="Collapsed">
                <!-- אובייקט: ForgotPanel — כרטיס איפוס הסיסמה. מוסתר עד שלוחצים על "שכחתי סיסמה". -->
                    <StackPanel Spacing="14">
                    <!-- אובייקט: StackPanel — השדות של איפוס הסיסמה, זה מתחת לזה. -->
                        <TextBlock Text="🔑 איפוס סיסמה"
                                   FontSize="22"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource RoseBrush}" />
                                   <!-- אובייקט: TextBlock — הכותרת "איפוס סיסמה". -->
                        <TextBlock Text="הקלידו את שם המשתמש ואת מילת הסוד שבחרתם בהגדרות, ואז סיסמה חדשה."
                                   FontSize="15"
                                   TextWrapping="Wrap"
                                   Foreground="{StaticResource MutedTextBrush}" />
                                   <!-- אובייקט: TextBlock — הסבר מה צריך להקליד כדי לאפס. -->
                        <TextBox x:Name="ForgotNameBox" Header="שם משתמש" FontSize="17" CornerRadius="12" />
                        <!-- אובייקט: ForgotNameBox — תיבה לשם המשתמש. -->
                        <PasswordBox x:Name="SecretWordBox" Header="מילת הסוד" FontSize="17" CornerRadius="12" />
                        <!-- אובייקט: SecretWordBox — תיבה למילת הסוד שנבחרה בהגדרות (מוסתרת). -->
                        <PasswordBox x:Name="NewPasswordBox" Header="סיסמה חדשה" FontSize="17" CornerRadius="12" />
                        <!-- אובייקט: NewPasswordBox — תיבה לסיסמה החדשה (מוסתרת). -->
                        <TextBlock x:Name="ForgotResultText" FontSize="15" TextWrapping="Wrap" Foreground="{StaticResource BerryBrush}" />
                        <!-- אובייקט: ForgotResultText — שורה שמראה אם האיפוס הצליח. -->
                        <Button Content="לאפס את הסיסמה" HorizontalAlignment="Stretch" Click="ResetPassword_Click" />
                        <!-- אובייקט: Button — כפתור "לאפס את הסיסמה". לחיצה מפעילה את ResetPassword_Click. -->
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</local:BasePage>

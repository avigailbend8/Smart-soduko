<Page
    x:Class="Smart_Sudoku.Pages.SingInPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Smart_Sudoku.Pages"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="Transparent">

    <Grid>
        <Button Style="{StaticResource CircleButton}"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Margin="24"
                ToolTipService.ToolTip="חזרה"
                AutomationProperties.Name="חזרה"
                Click="BackButton_Click">
            <FontIcon Glyph="&#xE72B;" FontSize="20" />
        </Button>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24,90,24,24" Spacing="20" Width="400">
                <TextBlock Text="התחברות" Style="{StaticResource TitleText}" />
                <TextBlock Text="ברוכים השבים! הכניסו שם משתמש וסיסמה" Style="{StaticResource SubtitleText}" />

                <Border Style="{StaticResource Card}" FlowDirection="RightToLeft">
                    <StackPanel Spacing="18">
                        <TextBox x:Name="UserNameBox"
                                 Header="שם משתמש"
                                 PlaceholderText="השם שלך"
                                 FontSize="18"
                                 CornerRadius="12"
                                 KeyDown="Field_KeyDown" />
                        <PasswordBox x:Name="PasswordBox"
                                     Header="סיסמה"
                                     FontSize="18"
                                     CornerRadius="12"
                                     KeyDown="Field_KeyDown" />
                        <TextBlock x:Name="ErrorText"
                                   Foreground="#FFD93A4A"
                                   FontSize="15"
                                   TextWrapping="Wrap"
                                   Visibility="Collapsed" />
                        <Button Content="התחבר" HorizontalAlignment="Stretch" Click="SignIn_Click" />
                        <HyperlinkButton Content="אין לך משתמש? להרשמה"
                                         HorizontalAlignment="Center"
                                         Foreground="{StaticResource RoseBrush}"
                                         Click="RegisterLink_Click" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>

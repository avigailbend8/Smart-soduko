<Page
    x:Class="Smart_Sudoku.Pages.LuckyWheelPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Smart_Sudoku.Pages"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="Transparent">

    <Grid>
        <Viewbox Margin="24,80,24,20" Stretch="Uniform" StretchDirection="DownOnly">
            <StackPanel Spacing="14" Width="560">
                <TextBlock x:Name="TitleText" Text="🎡 גלגל המזל" Style="{StaticResource TitleText}" />

                <!-- Regular or golden wheel -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="10" FlowDirection="RightToLeft">
                    <Button x:Name="RegularTab" Content="🎡 גלגל רגיל" FontSize="18" Padding="22,8" Click="RegularTab_Click" />
                    <Button x:Name="GoldenTab" Content="👑 גלגל הזהב" FontSize="18" Padding="22,8" Click="GoldenTab_Click" />
                </StackPanel>

                <TextBlock x:Name="InfoText" Style="{StaticResource SubtitleText}" FlowDirection="RightToLeft" />

                <!-- The wheel, drawn in code, with a pointer on top -->
                <Grid Width="440" Height="470" HorizontalAlignment="Center">
                    <Ellipse x:Name="WheelHalo" Width="440" Height="440" VerticalAlignment="Bottom" Opacity="0" />
                    <Canvas x:Name="Wheel" Width="400" Height="400" VerticalAlignment="Bottom" Margin="0,0,0,20" RenderTransformOrigin="0.5,0.5">
                        <Canvas.RenderTransform>
                            <RotateTransform x:Name="WheelRotation" />
                        </Canvas.RenderTransform>
                    </Canvas>
                    <Ellipse x:Name="Hub" Width="74" Height="74" VerticalAlignment="Bottom" Margin="0,0,0,183" StrokeThickness="4" />
                    <TextBlock x:Name="HubEmoji" Text="💖" FontSize="32" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,198" />
                    <Polygon x:Name="Pointer" Points="0,0 44,0 22,46" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,10,0,0" />
                </Grid>

                <TextBlock x:Name="ResultText"
                           Style="{StaticResource TitleText}"
                           FontSize="26"
                           FlowDirection="RightToLeft"
                           TextWrapping="Wrap" />

                <Button x:Name="SpinButton"
                        HorizontalAlignment="Stretch"
                        FontSize="24"
                        Padding="32,14"
                        BorderThickness="2.5"
                        BorderBrush="{StaticResource RoseBrush}"
                        Foreground="{StaticResource RoseBrush}"
                        Click="Spin_Click" />
                <Button x:Name="BuySpinButton"
                        HorizontalAlignment="Center"
                        FontSize="17"
                        Padding="24,8"
                        Click="BuySpin_Click" />
            </StackPanel>
        </Viewbox>

        <TextBlock x:Name="CoinsText"
                   HorizontalAlignment="Right"
                   VerticalAlignment="Top"
                   Margin="0,34,32,0"
                   FontSize="22"
                   FontWeight="SemiBold"
                   Foreground="{StaticResource BerryBrush}" />

        <Button Style="{StaticResource CircleButton}"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Margin="24"
                ToolTipService.ToolTip="חזרה"
                AutomationProperties.Name="חזרה"
                Click="BackButton_Click">
            <FontIcon Glyph="&#xE72B;" FontSize="20" />
        </Button>
    </Grid>
</Page>

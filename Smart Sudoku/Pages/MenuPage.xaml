<local:BasePage
    x:Class="Smart_Sudoku.Pages.MenuPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Smart_Sudoku.Pages"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="Transparent">

    <local:BasePage.Resources>
        <Style x:Key="Deco" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI Symbol" />
            <Setter Property="Foreground" Value="{StaticResource RoseBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- "Let's play" panel pops in -->
        <Storyboard x:Name="ShowPlayStoryboard">
            <DoubleAnimation Storyboard.TargetName="PlayPanel" Storyboard.TargetProperty="Opacity"
                             From="0" To="1" Duration="0:0:0.45" />
            <DoubleAnimation Storyboard.TargetName="PlayScale" Storyboard.TargetProperty="ScaleX"
                             From="0.8" To="1" Duration="0:0:0.6">
                <DoubleAnimation.EasingFunction>
                    <BackEase EasingMode="EaseOut" Amplitude="0.4" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="PlayScale" Storyboard.TargetProperty="ScaleY"
                             From="0.8" To="1" Duration="0:0:0.6">
                <DoubleAnimation.EasingFunction>
                    <BackEase EasingMode="EaseOut" Amplitude="0.4" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>

        <!-- Hearts float gently and sparkles twinkle -->
        <Storyboard x:Name="DecorStoryboard" RepeatBehavior="Forever">
            <DoubleAnimation Storyboard.TargetName="LeftHeartMove" Storyboard.TargetProperty="Y"
                             From="0" To="-10" Duration="0:0:1.2" AutoReverse="True">
                <DoubleAnimation.EasingFunction>
                    <SineEase EasingMode="EaseInOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="RightHeartMove" Storyboard.TargetProperty="Y"
                             From="-10" To="0" Duration="0:0:1.2" AutoReverse="True">
                <DoubleAnimation.EasingFunction>
                    <SineEase EasingMode="EaseInOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="TopSparkles" Storyboard.TargetProperty="Opacity"
                             From="1" To="0.45" Duration="0:0:1.2" AutoReverse="True" />
            <DoubleAnimation Storyboard.TargetName="BottomSparkles" Storyboard.TargetProperty="Opacity"
                             From="0.45" To="1" Duration="0:0:1.2" AutoReverse="True" />
        </Storyboard>
    </local:BasePage.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24,40" Spacing="16" MaxWidth="560">

            <Image Source="ms-appx:///Assets/Square150x150Logo.png" Width="130" Height="130" />

            <TextBlock Text="Smart Sudoku" Style="{StaticResource TitleText}" FontSize="46" />
            <TextBlock Text="סודוקו חכם ומתוק 💕" Style="{StaticResource SubtitleText}" Margin="0,0,0,16" />

            <!-- Step 1: choose how to play -->
            <StackPanel x:Name="ChoicePanel" Spacing="16" Width="380">
                <Button Content="התחבר למשתמש קיים"
                        HorizontalAlignment="Stretch"
                        Click="SignInButton_Click" />
                <Button Content="הרשמה למשתמש חדש"
                        HorizontalAlignment="Stretch"
                        Click="RegisterButton_Click" />
                <Button Content="המשך כאורח"
                        HorizontalAlignment="Stretch"
                        Click="GuestButton_Click" />
            </StackPanel>

            <!-- Step 2: "Let's play" with cute pink decorations -->
            <StackPanel x:Name="PlayPanel"
                        Spacing="14"
                        Visibility="Collapsed"
                        Opacity="0"
                        RenderTransformOrigin="0.5,0.5">
                <StackPanel.RenderTransform>
                    <ScaleTransform x:Name="PlayScale" />
                </StackPanel.RenderTransform>

                <StackPanel x:Name="TopSparkles" Orientation="Horizontal" HorizontalAlignment="Center" Spacing="18">
                    <TextBlock Text="✿" FontSize="22" Style="{StaticResource Deco}" Foreground="{StaticResource DecoBrush}" />
                    <TextBlock Text="✦" FontSize="16" Style="{StaticResource Deco}" Foreground="{StaticResource SoftPinkBrush}" />
                    <TextBlock Text="♥" FontSize="26" Style="{StaticResource Deco}" />
                    <TextBlock Text="✦" FontSize="16" Style="{StaticResource Deco}" Foreground="{StaticResource SoftPinkBrush}" />
                    <TextBlock Text="✿" FontSize="22" Style="{StaticResource Deco}" Foreground="{StaticResource DecoBrush}" />
                </StackPanel>

                <!-- The player's profile picture (filled in code) -->
                <ContentControl x:Name="AvatarHolder" HorizontalAlignment="Center" />

                <TextBlock x:Name="GreetingText"
                           Style="{StaticResource SubtitleText}"
                           Foreground="{StaticResource BerryBrush}"
                           FontSize="22"
                           FontWeight="SemiBold" />

                <!-- Player level and this week's league -->
                <Border HorizontalAlignment="Center"
                        Background="{StaticResource CardBrush}"
                        BorderBrush="{StaticResource SoftPinkBrush}"
                        BorderThickness="1"
                        CornerRadius="16"
                        Padding="16,6">
                    <TextBlock x:Name="LevelChip"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource BerryBrush}"
                               FlowDirection="RightToLeft" />
                </Border>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="18">
                    <TextBlock Text="♥" FontSize="34" Style="{StaticResource Deco}" Foreground="{StaticResource DecoBrush}">
                        <TextBlock.RenderTransform>
                            <TranslateTransform x:Name="LeftHeartMove" />
                        </TextBlock.RenderTransform>
                    </TextBlock>

                    <Button Content="Let's play  ▶"
                            Width="300"
                            FontSize="26"
                            Padding="32,18"
                            CornerRadius="24"
                            BorderThickness="2.5"
                            BorderBrush="{StaticResource RoseBrush}"
                            Foreground="{StaticResource RoseBrush}"
                            Click="LetsPlayButton_Click" />

                    <TextBlock Text="♥" FontSize="34" Style="{StaticResource Deco}" Foreground="{StaticResource DecoBrush}">
                        <TextBlock.RenderTransform>
                            <TranslateTransform x:Name="RightHeartMove" />
                        </TextBlock.RenderTransform>
                    </TextBlock>
                </StackPanel>

                <StackPanel x:Name="BottomSparkles" Orientation="Horizontal" HorizontalAlignment="Center" Spacing="14">
                    <TextBlock Text="✦" FontSize="14" Style="{StaticResource Deco}" Foreground="{StaticResource SoftPinkBrush}" />
                    <TextBlock Text="❀" FontSize="20" Style="{StaticResource Deco}" />
                    <TextBlock Text="✦" FontSize="14" Style="{StaticResource Deco}" Foreground="{StaticResource SoftPinkBrush}" />
                    <TextBlock Text="❀" FontSize="20" Style="{StaticResource Deco}" Foreground="{StaticResource DecoBrush}" />
                    <TextBlock Text="✦" FontSize="14" Style="{StaticResource Deco}" Foreground="{StaticResource SoftPinkBrush}" />
                </StackPanel>

                <Button x:Name="ContinueButton"
                        HorizontalAlignment="Center"
                        FontSize="19"
                        Padding="26,10"
                        Visibility="Collapsed"
                        Click="ContinueButton_Click" />

                <!-- Everything else to play, three in a row -->
                <Grid FlowDirection="RightToLeft" ColumnSpacing="10" RowSpacing="10" Width="520">
                    <Grid.Resources>
                        <Style TargetType="Button" BasedOn="{StaticResource WhiteButton}">
                            <Setter Property="FontSize" Value="17" />
                            <Setter Property="Padding" Value="10,10" />
                            <Setter Property="HorizontalAlignment" Value="Stretch" />
                        </Style>
                    </Grid.Resources>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Button x:Name="DailyButton" Click="DailyButton_Click" />
                    <Button Grid.Column="1" Content="🗺️ מסע הרפתקאות" Click="AdventureButton_Click" />
                    <Button Grid.Column="2" Content="⚔️ דו-קרב ברשת" Click="DuelButton_Click" />

                    <Button Grid.Row="1" Content="🧩 סודוקו קטן" Click="MiniButton_Click" />
                    <Button Grid.Row="1" Grid.Column="1" Content="🧘 מצב זן" Click="ZenButton_Click" />
                    <Button Grid.Row="1" Grid.Column="2" x:Name="WheelButton" Click="WheelButton_Click" />

                    <Button Grid.Row="2" x:Name="MissionsButton" Click="MissionsButton_Click" />
                    <Button Grid.Row="2" Grid.Column="1" Content="🏅 הישגים" Click="AchievementsButton_Click" />
                    <Button Grid.Row="2" Grid.Column="2" Content="📊 סטטיסטיקות" Click="StatsButton_Click" />

                    <Button Grid.Row="3" Content="🏆 טבלת שיאים" Click="LeaderboardButton_Click" />
                    <Button Grid.Row="3" Grid.Column="1" x:Name="FriendsButton" Content="👭 חברים" Click="FriendsButton_Click" />
                    <Button Grid.Row="3" Grid.Column="2" Content="⚙️ הגדרות" Click="SettingsButton_Click" />
                </Grid>

                <Button Content="החלף משתמש"
                        HorizontalAlignment="Center"
                        FontSize="16"
                        Padding="22,8"
                        Margin="0,12,0,0"
                        Click="SwitchUserButton_Click" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</local:BasePage>

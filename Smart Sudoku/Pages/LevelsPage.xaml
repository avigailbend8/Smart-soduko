<Page
    x:Class="Smart_Sudoku.Pages.LevelsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Smart_Sudoku.Pages"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="Transparent">

    <Grid>
        <Button Style="{StaticResource CircleButton}"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Margin="24"
                ToolTipService.ToolTip="חזרה"
                AutomationProperties.Name="חזרה"
                Click="BackButton_Click">
            <FontIcon Glyph="&#xE72B;" FontSize="20" />
        </Button>

        <!-- Coins and store -->
        <StackPanel Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Margin="24"
                    Spacing="16">
            <TextBlock x:Name="CoinsText"
                       FontSize="22"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource BerryBrush}"
                       VerticalAlignment="Center"
                       Text="🪙 0" />
            <Button Padding="34,16"
                    FontSize="26"
                    CornerRadius="22"
                    BorderThickness="2.5"
                    BorderBrush="{StaticResource RoseBrush}"
                    Foreground="{StaticResource RoseBrush}"
                    AutomationProperties.Name="חנות"
                    Click="StoreButton_Click">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <TextBlock Text="🛍️" FontSize="30" />
                    <TextBlock Text="חנות" FontWeight="Bold" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
        </StackPanel>

        <Viewbox Margin="24,96,24,24" Stretch="Uniform" StretchDirection="DownOnly">
            <StackPanel Spacing="12">
                <TextBlock Text="Levels" Style="{StaticResource TitleText}" />
                <TextBlock Text="סיימו שלב כדי לפתוח את הבא — וכמה שפחות טעויות, יותר כוכבים ⭐"
                           Style="{StaticResource SubtitleText}" />

                <!-- Difficulty tabs, filled in code -->
                <StackPanel x:Name="DifficultyPanel"
                            Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            Spacing="12"
                            Margin="0,8,0,16"
                            FlowDirection="RightToLeft" />

                <!-- Filled with level buttons in code -->
                <Grid x:Name="LevelsGrid" ColumnSpacing="16" RowSpacing="16" HorizontalAlignment="Center" />
            </StackPanel>
        </Viewbox>
    </Grid>
</Page>

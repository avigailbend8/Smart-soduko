<local:BasePage
    x:Class="Smart_Sudoku.Pages.LevelsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Smart_Sudoku.Pages"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="Transparent">
    <!-- אובייקט: LevelsPage — עמוד בחירת השלבים. יורש מ-BasePage, והרקע שלו שקוף. -->

    <Grid>
    <!-- אובייקט: Grid — "מגש" שמחזיק את כפתור החזרה, את המטבעות והחנות, ואת רשימת השלבים. -->
        <Button Style="{StaticResource CircleButton}"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Margin="24"
                ToolTipService.ToolTip="חזרה"
                AutomationProperties.Name="חזרה"
                Click="BackButton_Click">
                <!-- אובייקט: Button — כפתור "חזרה" עגול בפינה (BackButton_Click). -->
            <FontIcon Glyph="&#xE72B;" FontSize="20" />
            <!-- אובייקט: FontIcon — האייקון של החץ שבתוך כפתור החזרה. -->
        </Button>

        <!-- Coins and store -->
        <StackPanel Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Margin="24"
                    Spacing="16">
                    <!-- אובייקט: StackPanel — שורה בפינה הימנית: כמה מטבעות יש, וכפתור החנות. -->
            <TextBlock x:Name="CoinsText"
                       FontSize="22"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource BerryBrush}"
                       VerticalAlignment="Center"
                       Text="🪙 0" />
                       <!-- אובייקט: CoinsText — הטקסט שמראה כמה מטבעות יש לשחקן. -->
            <Button Padding="34,16"
                    FontSize="26"
                    CornerRadius="22"
                    BorderThickness="2.5"
                    BorderBrush="{StaticResource RoseBrush}"
                    Foreground="{StaticResource RoseBrush}"
                    AutomationProperties.Name="חנות"
                    Click="StoreButton_Click">
                    <!-- אובייקט: Button — כפתור החנות הגדול (StoreButton_Click). -->
                <StackPanel Orientation="Horizontal" Spacing="10">
                <!-- אובייקט: StackPanel — מה שבתוך כפתור החנות: אימוג'י ומילה, זה לצד זה. -->
                    <TextBlock Text="🛍️" FontSize="30" />
                    <!-- אובייקט: TextBlock — האימוג'י של שקית הקניות. -->
                    <TextBlock Text="חנות" FontWeight="Bold" VerticalAlignment="Center" />
                    <!-- אובייקט: TextBlock — המילה "חנות". -->
                </StackPanel>
            </Button>
        </StackPanel>

        <Viewbox Margin="24,96,24,24" Stretch="Uniform" StretchDirection="DownOnly">
        <!-- אובייקט: Viewbox — מקטין את התוכן כשהחלון קטן, כדי שכל השלבים ייכנסו. -->
            <StackPanel Spacing="12">
            <!-- אובייקט: StackPanel — עמודה עם הכותרת, הלשוניות והשלבים. -->
                <TextBlock Text="Levels" Style="{StaticResource TitleText}" />
                <!-- אובייקט: TextBlock — הכותרת "Levels". -->
                <TextBlock Text="סיימו שלב כדי לפתוח את הבא — וכמה שפחות טעויות, יותר כוכבים ⭐"
                           Style="{StaticResource SubtitleText}" />
                           <!-- אובייקט: TextBlock — הסבר קצר: מסיימים שלב כדי לפתוח את הבא. -->

                <!-- Difficulty tabs, filled in code -->
                <StackPanel x:Name="DifficultyPanel"
                            Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            Spacing="12"
                            Margin="0,8,0,16"
                            FlowDirection="RightToLeft" />
                            <!-- אובייקט: DifficultyPanel — שורת הלשוניות של רמות הקושי. הקוד ממלא אותה. -->

                <!-- Filled with level buttons in code -->
                <Grid x:Name="LevelsGrid" ColumnSpacing="16" RowSpacing="16" HorizontalAlignment="Center" />
                <!-- אובייקט: LevelsGrid — הטבלה של כפתורי השלבים (5 בשורה). הקוד ממלא אותה. -->
            </StackPanel>
        </Viewbox>
    </Grid>
</local:BasePage>
